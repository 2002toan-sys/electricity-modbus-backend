# Production environment for Hotel Modbus backend.
# Copy this file to .env, then replace the secret values before deployment.
NODE_ENV=production

# Required. Generate a unique value with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=hotel-modbus-system
JWT_AUDIENCE=hotel-modbus-frontend
# Access tokens are limited to 15 minutes or less.
ACCESS_TOKEN_TTL_SECONDS=900

# Used only once by the account-reset migration on the next deployment.
# It deletes all existing user accounts and creates exactly one admin account.
# Use a username (3-32 letters/numbers/._-) and a unique password of 12-128 characters.
# Required only until this one-time migration has run successfully.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Refresh token cookie. HTTPS must terminate at the reverse proxy in production.
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=true

# Optional. Keep empty unless a trusted third-party integration needs admin API access.
# When enabled, use a unique random value of at least 32 characters.
API_KEY=

# Absolute writable host directories mounted by docker-compose.yml.
# Create these on the server and grant UID 1000 (the container's node user) write access.
BACKEND_DATA_DIR=/opt/hotel-modbus/backend/data
BACKEND_LOGS_DIR=/opt/hotel-modbus/backend/logs

# Logs are also sent to container stdout/stderr.
LOG_TO_FILE=true
# Winston levels: error, warn, info, http, verbose, debug, silly.
LOG_LEVEL=info
