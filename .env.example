# Backend Environment Variables

# Node environment
NODE_ENV=production
# Required: use a unique random value of at least 32 characters.
JWT_SECRET=generate-a-unique-secret-of-at-least-32-characters
# Optional: enable X-API-Key integration; leave empty to disable it.
API_KEY=
# Required bind-mount source directories on the Docker host.
BACKEND_DATA_DIR=/home/hotel-modbus-backend-v2/data
BACKEND_LOGS_DIR=/home/hotel-modbus-backend-v2/logs

# Set false to disable file logs (console output remains enabled).
LOG_TO_FILE=true
# Winston log level: error, warn, info, http, verbose, debug, or silly.
LOG_LEVEL=info
